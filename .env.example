# Telegram Bot Configuration
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here


# Server Configuration
PORT=3000
NODE_ENV=development

# AI Services (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API (For hotel discovery - https://console.cloud.google.com/apis)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Logging
LOG_LEVEL=info

# File Processing
MAX_FILE_SIZE=20971520
SUPPORTED_FORMATS=pdf,jpg,jpeg,png,webp,txt,md

# Webhook Configuration (for production)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
# SQLite database will be created automatically as database.sqlite
# For production, consider using PostgreSQL or MySQL
DATABASE_TYPE=sqlite
DATABASE_STORAGE=database.sqlite

# For PostgreSQL (production)
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/telegrambot

# For MySQL (production)  
# DATABASE_TYPE=mysql
# DATABASE_URL=mysql://user:password@localhost:3306/telegrambot

# Database Logging (set to false in production)
DATABASE_LOGGING=true

# Data Cleanup (days to keep old data)
CLEANUP_DAYS=30

# Redis (Optional - for advanced session management)
# REDIS_URL=redis://localhost:6379